TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
PUBLIC_URL=https://your-app.up.railway.app
# Path to a persistent Volume mount on Railway (Settings -> Volumes) so
# save data survives redeploys. Without this, saves live only in the
# container's ephemeral filesystem and are lost on every redeploy.
DATA_DIR=/data
